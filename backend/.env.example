# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a Git.

NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/cancha_futbol

# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL(s) del frontend, separadas por coma
CLIENT_URL=http://localhost:5173

# lax (por defecto) | strict | none  -> usa "none" solo si front y API están en dominios distintos y con HTTPS
COOKIE_SAMESITE=lax

TIMEZONE=America/Bogota
