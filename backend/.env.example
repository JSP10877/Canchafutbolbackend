# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a Git.

NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/cancha_futbol

# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL(s) del frontend, separadas por coma
CLIENT_URL=http://localhost:5173

# lax (por defecto) | strict | none  -> usa "none" solo si front y API están en dominios distintos y con HTTPS
COOKIE_SAMESITE=lax

TIMEZONE=America/Bogota

# --- Solo para "npm run seed:admin" (crear o designar un administrador) ---
# Si el correo ya existe, ese usuario pasa a ser admin y NO se toca su contraseña.
# Si no existe, se crea con esta contraseña (mínimo 8 caracteres).
# Bórralos de tu .env cuando termines.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@tudominio.com
ADMIN_PASSWORD=
